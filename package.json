{
  "name": "tien404-ai-website",
  "version": "2.1.0",
  "private": true,
  "description": "TIEN404 AI public website (GitHub Pages) built from site-src; old motion Sass kept in src/scss",
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "build:css": "sass --no-source-map --style=compressed src/scss/main.scss assets/style.css",
    "test": "python -m unittest discover -s tests -v",
    "qa:static": "python qa_static.py"
  },
  "devDependencies": {
    "sass": "^1.93.0"
  }
}
