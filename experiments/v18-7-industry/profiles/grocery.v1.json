{
  "schema_version": "1.0.0",
  "id": "grocery",
  "version": "1.0.0",
  "stage": "EXPERIMENTAL",
  "name_vi": "Tạp hóa và siêu thị mini",
  "locale": "vi-VN",
  "fields": {
    "product": [
      "sku",
      "product_name",
      "base_unit",
      "unit_conversion",
      "price_vnd",
      "stock_base",
      "expiry_date"
    ],
    "customer": [
      "contact_ref",
      "price_group"
    ]
  },
  "skills": [
    "product_lookup",
    "unit_conversion",
    "stock_check",
    "quote_preview",
    "human_handoff"
  ],
  "business_rules": {
    "price_source": "canonical_commerce",
    "stock_source": "canonical_commerce",
    "unknown_price": "DENY",
    "unknown_stock": "DENY",
    "cross_store": "DENY",
    "order_write": "DENY",
    "provider_send": "DENY"
  },
  "capabilities": {
    "channels": [
      "messenger",
      "zalo_oa",
      "website"
    ],
    "tools": {
      "allow": [
        "search_products",
        "read_price",
        "check_inventory",
        "preview_quote"
      ],
      "deny": [
        "create_order",
        "update_order",
        "cancel_order",
        "update_stock",
        "update_debt",
        "provider_send",
        "read_private_order",
        "admin_action"
      ]
    }
  },
  "defaults": {
    "tone": "friendly",
    "greeting": "Xin chào! Tôi có thể giúp tìm sản phẩm, kiểm tra giá và hàng còn tại cửa hàng."
  }
}
