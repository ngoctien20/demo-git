{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TIEN404 Industry Profile Contract V1 — NO LIVE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "stage",
    "name_vi",
    "locale",
    "fields",
    "skills",
    "business_rules",
    "capabilities",
    "defaults"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "enum": [
        "grocery",
        "building_materials"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "stage": {
      "const": "EXPERIMENTAL"
    },
    "name_vi": {
      "type": "string",
      "minLength": 4,
      "maxLength": 90
    },
    "locale": {
      "const": "vi-VN"
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "customer"
      ],
      "properties": {
        "product": {
          "type": "array",
          "minItems": 4,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{1,40}$"
          }
        },
        "customer": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z_]{1,40}$"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "product_lookup",
          "unit_conversion",
          "stock_check",
          "quote_preview",
          "human_handoff",
          "specification_clarification"
        ]
      }
    },
    "business_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price_source",
        "stock_source",
        "unknown_price",
        "unknown_stock",
        "cross_store",
        "order_write",
        "provider_send"
      ],
      "properties": {
        "price_source": {
          "const": "canonical_commerce"
        },
        "stock_source": {
          "const": "canonical_commerce"
        },
        "unknown_price": {
          "const": "DENY"
        },
        "unknown_stock": {
          "const": "DENY"
        },
        "cross_store": {
          "const": "DENY"
        },
        "order_write": {
          "const": "DENY"
        },
        "provider_send": {
          "const": "DENY"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channels",
        "tools"
      ],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "messenger",
              "zalo_oa",
              "website"
            ]
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allow",
            "deny"
          ],
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "search_products",
                  "read_price",
                  "check_inventory",
                  "preview_cart",
                  "preview_quote"
                ]
              }
            },
            "deny": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "create_order",
                  "update_order",
                  "cancel_order",
                  "update_stock",
                  "update_debt",
                  "provider_send",
                  "read_private_order",
                  "admin_action"
                ]
              }
            }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tone",
        "greeting"
      ],
      "properties": {
        "tone": {
          "enum": [
            "friendly",
            "practical",
            "professional",
            "brief"
          ]
        },
        "greeting": {
          "type": "string",
          "minLength": 6,
          "maxLength": 240
        }
      }
    }
  }
}
